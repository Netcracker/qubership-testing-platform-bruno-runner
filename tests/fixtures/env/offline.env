# Minimal env for offline E2E runs of entrypoint.sh
LOCAL_RUN=true
ATP_STORAGE_USERNAME=dummy
ATP_STORAGE_PASSWORD=dummy
ATP_STORAGE_BUCKET=dummy
ATP_STORAGE_PROVIDER=minio
ATP_STORAGE_REGION=us-east-1
ATP_STORAGE_SERVER_URL=http://127.0.0.1:1
ATP_TESTS_GIT_REPO_URL=
ATP_TESTS_GIT_REPO_BRANCH=
ATP_TESTS_GIT_TOKEN=
ENVIRONMENT_NAME=local
